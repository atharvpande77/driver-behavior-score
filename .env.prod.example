# ── Production environment ──────────────────────────────────────────────────
# Copy this file to .env on the production server and fill in values.
# Never commit this file or .env to git.
#
# Startup command (prod server):
#   docker compose -f docker-compose.yml up -d
# (Explicit -f prevents docker-compose.override.yml from being auto-loaded)

ENVIRONMENT=production
APP_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Within the Docker network, postgres is reachable at postgres:5432.
DATABASE_URL=postgresql+asyncpg://dbs_user:<secure-prod-password>@postgres:5432/dbs
POSTGRES_USER=dbs_user
POSTGRES_PASSWORD=<secure-prod-password>
POSTGRES_DB=dbs
POSTGRES_PORT=5432

# ── Backend ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed production domains
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# ── Surepass credentials ──────────────────────────────────────────────────────
# Production credentials used for live vehicle and challan fetches.
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_API_KEY=Bearer <your-production-token-here>

# ── OpenAI ───────────────────────────────────────────────────────────────────
# OpenAI credentials for live classification of traffic violations.
OPENAI_API_KEY=sk-proj-<your-openai-api-key>

# ── JWT (use highly secure, randomly generated keys for production) ──────────
# Generate strong secrets via: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_USE_COLORS=false
