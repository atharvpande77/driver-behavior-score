# ── Staging environment ─────────────────────────────────────────────────────
# Copy this file to .env.staging and fill in values.
# .env.staging is gitignored — never commit it.

ENVIRONMENT=staging
APP_PORT=8001
STAGING_APP_PORT=8001

# ── Database ─────────────────────────────────────────────────────────────────
# Within the Docker network, postgres is reachable at postgres:5432.
# Note: DATABASE_URL is also pinned in docker-compose.staging.yml's environment:
# block to prevent it from being overridden by the base .env file. Keep this
# value consistent with what is set there (dbs_staging).
DATABASE_URL=postgresql+asyncpg://dbs_user:<password>@postgres:5432/dbs_staging
POSTGRES_USER=dbs_user
POSTGRES_PASSWORD=<password>
POSTGRES_DB=dbs_staging
POSTGRES_PORT=5432

# ── Backend ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ── Surepass sandbox credentials ─────────────────────────────────────────────
# SUREPASS_BASE_URL and SUREPASS_API_KEY are still required fields in AppSettings.
# Set them to anything (or the production values) — they will NOT be called in
# staging as long as SUREPASS_SANDBOX_* are populated.
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_API_KEY=staging-placeholder-not-used
SUREPASS_SANDBOX_BASE_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_SANDBOX_API_KEY=<your-sandbox-token-here>

# ── OpenAI — not called in staging ───────────────────────────────────────────
# AppSettings requires OPENAI_API_KEY as a non-optional field.
# Set any non-empty placeholder; the key is never sent to OpenAI in staging
# because _classify_with_openai short-circuits on ENVIRONMENT == "staging".
OPENAI_API_KEY=staging-placeholder-not-used

# ── JWT (use staging-specific secrets, distinct from production) ──────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_USE_COLORS=true
